# ─────────────────────────────────────────────────────────────────────────────
# AGBONS-GL — environment configuration
# Copy to `.env` (or `.env.local`) and replace the sample values with real data.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser; never put secrets
# in them. Rebuild after changing NEXT_PUBLIC_ values (they are inlined at build).
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin, used for SEO metadata, sitemap and WhatsApp product links.
NEXT_PUBLIC_SITE_URL=https://agbons-gl.com

# ── Contact & conversion (audit §1) ──────────────────────────────────────────
# WhatsApp number in international format, digits only (no +, spaces or dashes).
NEXT_PUBLIC_WHATSAPP_NUMBER=2347056814352
NEXT_PUBLIC_CONTACT_EMAIL=info@agbons-gl.com
NEXT_PUBLIC_CONTACT_PHONE=+234 705 681 4352

# ── Social profiles (audit §5.4 — confirm the real profile URLs) ─────────────
# Leave a value empty to hide that icon.
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/agbonsgl
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/agbonsgl
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@agbonsgl
NEXT_PUBLIC_X_URL=


# ── Newsletter (audit §5.8, TRD §8 forms) ────────────────────────────────────
# Provider: "mailchimp" or "log" (log = print to server console, for local dev).
NEWSLETTER_PROVIDER=log
MAILCHIMP_API_KEY=your-mailchimp-api-key-us21
MAILCHIMP_SERVER_PREFIX=us21
MAILCHIMP_AUDIENCE_ID=your-audience-id

# ── Form notifications (contact form + bespoke consultation intake) ──────────
# Submissions are emailed via Resend (https://resend.com) when RESEND_API_KEY is
# set, and/or POSTed as JSON to FORMS_WEBHOOK_URL (Zapier, Make, Slack, CRM…).
# With neither set, submissions are logged to the server console.
RESEND_API_KEY=
FORMS_NOTIFY_EMAIL=info@agbons-gl.com
FORMS_FROM_EMAIL=AGBONS-GL Website <website@agbons-gl.com>
FORMS_WEBHOOK_URL=

# ── Analytics (TRD §8 — none detected on the current site) ───────────────────
# Leave empty to disable. Scripts load only when an ID is present.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-YBQZ4PY08E
NEXT_PUBLIC_META_PIXEL_ID=

# ── Admin dashboard (/admin) ─────────────────────────────────────────────────
# Shared admin password. Use a long passphrase in production.
ADMIN_PASSWORD=change-me-to-a-long-passphrase
# Signs admin session cookies. 32+ random characters, e.g. `openssl rand -hex 32`.
# Changing it signs everyone out.
ADMIN_SESSION_SECRET=replace-with-64-random-hex-characters-0000000000000000000000000000
# Netlify only: personal access token so `next build` can read admin content
# from Netlify Blobs (User settings → Applications → Personal access tokens).
# Not needed locally — local edits are stored in .data/.
NETLIFY_BLOBS_TOKEN=
